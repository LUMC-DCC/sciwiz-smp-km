,"value":[]},"requiredPhaseUuid":{"changed":true,"value":"fd08c186-34f3-4104-8715-702e8623393c"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564"]},"text":{"changed":false},"title":{"changed":true,"value":"File URL"},"validations":{"changed":true,"value":[]},"valueType":{"changed":true,"value":"UrlQuestionValueType"}},"createdAt":"2026-05-10T21:57:57Z","entityUuid":"f4ed208d-92a2-4a9c-b188-2a8da0fe4297","parentUuid":"ccdee4ad-550f-4937-9661-c370e8f01ff9","uuid":"dc27bf5e-6194-4d47-8ee7-2a2bb8e84332"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"questionType":"ValueQuestion","referenceUuids":{"changed":true,"value":["a4bc467b-0ddc-4365-afd8-0e024891a64c"]},"requiredPhaseUuid":{"changed":true,"value":"92aed7aa-9d45-47f4-8a27-a1261e89aa5d"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564"]},"text":{"changed":true,"value":"The identifier under which the archived version stays citable."},"title":{"changed":true,"value":"Persistent identifier"},"validations":{"changed":true,"value":[]},"valueType":{"changed":true,"value":"UrlQuestionValueType"}},"createdAt":"2026-05-10T21:57:58Z","entityUuid":"f8442558-628e-437c-a1eb-b4331a85513b","parentUuid":"082b2cc8-b380-46e3-ba15-1cb69d5be841","uuid":"b334238f-be7b-4849-a176-5826378f6289"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"questionType":"ValueQuestion","referenceUuids":{"changed":true,"value":[]},"requiredPhaseUuid":{"changed":true,"value":"fd08c186-34f3-4104-8715-702e8623393c"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564"]},"text":{"changed":false},"title":{"changed":true,"value":"Schema / constraints"},"validations":{"changed":true,"value":[]},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2026-05-10T21:57:59Z","entityUuid":"f8b5d702-1d55-41e3-88a4-f9b7d70daae7","parentUuid":"ed5d2980-ecaa-4654-a6a8-8a8dff5920fb","uuid":"92cf5067-a254-4638-9bb3-c66c3b016dd0"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"questionType":"ValueQuestion","referenceUuids":{"changed":true,"value":[]},"requiredPhaseUuid":{"changed":true,"value":"fd08c186-34f3-4104-8715-702e8623393c"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564","f137aaf2-c1a7-429b-b498-2c80eb9f2a7d"]},"text":{"changed":false},"title":{"changed":true,"value":"Note"},"validations":{"changed":true,"value":[]},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2026-05-10T21:58:00Z","entityUuid":"fcccd1a5-305e-481b-9473-1a41d2a30594","parentUuid":"6b175013-2200-4a1f-956a-98b6fba946ec","uuid":"f753e988-a498-4c9b-9b22-bad977aff0b8"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"questionType":"ValueQuestion","referenceUuids":{"changed":true,"value":[]},"requiredPhaseUuid":{"changed":true,"value":"a664ce2c-83b0-411a-bdf5-4f829a4ecc25"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564"]},"text":{"changed":true,"value":"E.g.: External Slack support contract, DCC consultancy, Snellius CPU allocation."},"title":{"changed":true,"value":"Service / partner"},"validations":{"changed":true,"value":[]},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2026-05-10T21:58:01Z","entityUuid":"fd4eb5dd-e059-4666-816b-4d08f140f832","parentUuid":"9bbd58d5-d341-4d4a-b790-2127c5abe948","uuid":"aa42a182-9e31-4d63-9a2a-e4445516d80b"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["5b83e230-b057-46fb-8646-3b5ffbc57f97","efbb304a-6196-4cc2-95a9-e7f5c2448a60"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"questionType":"OptionsQuestion","referenceUuids":{"changed":true,"value":["f98b827b-2254-4a73-b6fe-457e4892ded7"]},"requiredPhaseUuid":{"changed":true,"value":"de478e18-2a3e-4349-804c-f1d8974897b1"},"tagUuids":{"changed":true,"value":["f137aaf2-c1a7-429b-b498-2c80eb9f2a7d","b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564"]},"text":{"changed":true,"value":"Does the software have a persistent identifier (PID): a stable, resolvable URL that survives platform migrations and renames? The most common PID is a **DOI** minted by Zenodo when you archive a tagged release.\n\nRecommended workflow: connect your repo to Zenodo → push a tag → create a Release → Zenodo mints a version-DOI and a concept DOI that always points to the latest version."},"title":{"changed":true,"value":"Associated persistent identifiers"}},"createdAt":"2026-05-10T21:58:02Z","entityUuid":"fe9a0536-34a2-4637-82c1-658f281354b3","parentUuid":"d93d3f14-7bab-440c-8369-d9f6b299e976","uuid":"fc4dc896-783d-45bf-94e6-5f6e91ac56d7"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"itemTemplateQuestionUuids":{"changed":true,"value":["b6fb55b3-7f6d-4529-ad90-ffc5f0901782","ea84f55f-d6e3-4c4e-9252-4660cc20136c"]},"questionType":"ListQuestion","referenceUuids":{"changed":true,"value":[]},"requiredPhaseUuid":{"changed":true,"value":"de478e18-2a3e-4349-804c-f1d8974897b1"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564"]},"text":{"changed":false},"title":{"changed":true,"value":"Management tools"}},"createdAt":"2026-05-10T21:58:03Z","entityUuid":"fec554ae-6db7-4223-b500-badc3c0a1ca4","parentUuid":"308bcce6-0678-479f-a342-5869d7de58ed","uuid":"ff02a09a-0af5-4247-a445-1401b54eabcf"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUui