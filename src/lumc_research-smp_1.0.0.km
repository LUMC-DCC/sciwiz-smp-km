3e-4349-804c-f1d8974897b1"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e"]},"text":{"changed":true,"value":"What is the contingency plan if something fails? What are the responsibilities, escalation procedures, and commitments in the event of a failure?\nMitigations don't have to be elaborate.\n\nIf the mitigation risks are outlined in the DMP, say so explicitly. Check with your departmental SOP, if available."},"title":{"changed":true,"value":"Mitigation"},"validations":{"changed":true,"value":[]},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2026-05-10T21:55:15Z","entityUuid":"0a4c4dce-1969-48e1-a6e8-32dce8425d59","parentUuid":"dcba8e26-64b4-4fc5-86aa-4a42178c383a","uuid":"866d26fe-2714-4ed8-945f-11a736fbc520"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"itemTemplateQuestionUuids":{"changed":true,"value":["569d9173-1ad5-492d-a384-020d0e06449f","f4b9078b-b02c-43ba-bc5b-0a583f653069","4547d942-8960-43f1-9190-715fc3c84c21","c97f9312-a3fb-47b3-802e-3dbdfe296603"]},"questionType":"ListQuestion","referenceUuids":{"changed":true,"value":["3214c9b3-2510-4d8d-80a1-8cd330cb4af3"]},"requiredPhaseUuid":{"changed":true,"value":"a664ce2c-83b0-411a-bdf5-4f829a4ecc25"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564"]},"text":{"changed":true,"value":"List existing software, libraries or pipelines that this project builds on, depends on, or interoperates with.  \nIt makes lineage explicit, which is essential for citation and helps reviewers see what is genuinely new. This is not a full dependency manifest but rather a conceptual lineage."},"title":{"changed":true,"value":"Related / upstream software"}},"createdAt":"2026-05-10T21:55:16Z","entityUuid":"0fe887b5-a6eb-497b-ab6a-05c0c362a59b","parentUuid":"2f8a5871-b095-4c59-962d-9609220c2f0a","uuid":"1e23f347-457c-48cc-ae6e-b4ea726fcc05"},{