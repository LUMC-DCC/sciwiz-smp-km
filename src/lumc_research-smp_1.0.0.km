ion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false}},"createdAt":"2026-09-02T05:11:54Z","entityUuid":"06b6d6d9-5942-4a2a-aecb-6bc9336505e3","parentUuid":"ba141448-f70d-4c95-b42c-be93a392936e","uuid":"6c6275c6-cc98-47fd-8c98-414e8f3dfce3"}],"forkOfPackageId":null,"id":"lumc:research-smp:1.0.0","kmId":"research-smp","license":"CC-BY 4.0 ","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"LUMC-DCC Software Management Plan","nonEditable":false,"organizationId":"lumc","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":null,"readme":"# Research SMP knowledge model\n\nThis is Knowledge Model for creating **Software Management Plans (SMPs)** using the [Data Stewardship Wizard (DSW)](https://ds-wizard.org).  \nIt is designed to guide researchers and research software developers in documenting software development, sharing, maintenance, and reuse practices.\n\n--- \n\n## License\n\nContents are licensed under the [Creative Commons Attribution 4.0 International (CC BY 4.0)](https://creativecommons.org/licenses/by/4.0/).\n\n","version":"1.0.0"}],"version":"1.0.0"}