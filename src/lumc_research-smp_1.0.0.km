.5},{"measure":0.75,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":0.5}]}},"createdAt":"2026-05-10T21:53:11Z","entityUuid":"d9f66fa4-4d0e-4ed8-9786-68dfa63dc8a5","parentUuid":"8fe87903-df9b-4e85-8f80-471a46e20e59","uuid":"00b5358b-ee7f-4403-8236-ea119540d2e3"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"Officially supported"},"metricMeasures":{"changed":false}},"createdAt":"2026-05-10T21:53:12Z","entityUuid":"da90c752-3662-465c-bde1-84a268f460e5","parentUuid":"66898ced-0079-43ca-82f2-3c8d2050c87b","uuid":"b29b5120-1d67-4b26-bd38-386b2b150c4e"},{"content":{"advice":{"changed":true,"value":"For most research software the repository page is a perfectly good homepage. Pick \"No\" only if there is genuinely nowhere you could send someone to read about this software."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":true,"value":[{"measure":0,"metricUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","weight":1},{"measure":0,"metricUuid":"c23f39d1-907b-4a54-9add-51f7254b3561","weight":1}]}},"createdAt":"2026-05-10T21:53:13Z","entityUuid":"dbe1ec28-36d9-4fa3-a33d-f76fc13b0027","parentUuid":"86a05257-2a79-4779-9ed6-1e1c02061f60","uuid":"30eaace3-d2e6-4363-b2fb-d71b2a4e6e62"},{"content":{"advice":{"changed":true,"value":"A separate Data Management Plan is likely required. Confirm with a central or your division's data steward. See [LUMC Data Stewardship](https://www.albinusnet.nl/actueel/themas/datastewardship/)."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["823a9b7b-5627-4d01-a136-06a2f19a0455","ddb3fe31-c887-43f8-9651-77324d26f8b3","0a4c4dce-1969-48e1-a6e8-32dce8425d59"]},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2026-05-10T21:53:14Z","entityUuid":"dcba8e26-64b4-4fc5-86aa-4a42178c383a","parentUuid":"9ffa6c58-87eb-41cc-b161-39501bf4a4a3","uuid":"254618b5-48cf-49ab-907a-8cdfc3dc1fab"},{"content":{"advice":{"changed":true,"value":"\"No\" means: no personal data, no clinical data, no patient-derived data, no contact data of identifiable people, no data covered by an institutional sensitivity policy. If your software might in the future be applied to such data by a downstream user, that's covered under User-supplied only - pick that instead."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2026-05-10T21:53:15Z","entityUuid":"e10ae8ce-4990-4aa6-b232-48484b03d4fa","parentUuid":"9ffa6c58-87eb-41cc-b161-39501bf4a4a3","uuid":"f1c310a5-29b6-467c-95a1-393e9f1997e6"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"Security maintenance only"},"metricMeasures":{"changed":true,"value":[{"measure":0.5,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":0.5}]}},"createdAt":"2026-05-10T21:53:16Z","entityUuid":"e230a33b-598d-4ab6-ae48-7e540771a313","parentUuid":"2c78ad92-db2e-43d3-b5d1-61ec4b3b1694","uuid":"a4233d75-f7cb-490d-b9ad-2d3faeb28ece"},{"content":{"advice":{"changed":true,"value":"At LUMC, consider contacting LURIS Legal ([lurislegal@lumc.nl](mailto:lurislegal@lumc.nl)). Commercialization constrains which license you can pick, and a public disclosure before that conversation can foreclose options permanently."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["e4ecc62f-cb00-427b-9011-124900d27667"]},"label":{"changed":true,"value":"Commercial"},"metricMeasures":{"changed":true,"value":[{"measure":0,"metricUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","weight":1},{"measure":0.25,"metricUuid":"f6694694-75c5-443a-b925-c5d8480becf3","weight":0.5}]}},"createdAt":"2026-05-10T21:53:17Z","entityUuid":"e241f5ea-a332-447a-ab79-2f9a9deec733","parentUuid":"a844a241-ddd1-49bd-b98b-0548689547e4","uuid":"9b7c64b8-f144-4d91-83c3-c56efe2942d9"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"Web API"},"metricMeasures":{"changed":false}},"createdAt":"2026-05-10T21:53:18Z","entityUuid":"e6162867-377a-4567-88de-7c5350c2098c","parentUuid":"3a92e33c-aa40-400f-8e2b-4c4c140090a0","uuid":"bcedc52f-dfaa-40e4-899a-73d9820e49cf"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["7d2a4597-d792-4e5f-80a9-4f53fb16805b","5ed0a9a7-16f7-451d-8f22-881b1c60f2ea"]},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":true,"value":[{"measure":1,"metricUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","weight":1},{"measure":1,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":1}]}},"createdAt":"2026-05-10T21:53:19Z","entityUuid":"ee641ccf-8f02-4191-a3cc-6f92b3e2f16c","parentUuid":"bcd77cf1-06b8-4867-a7a5-3dcdf5f72b04","uuid":"74748d46-258c-423c-aa88-3426bcdb991a"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["7ef49f2e-9981-421b-8a23-d1c5f181c741"]},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2026-05-10T21:53:20Z","entityUuid":"ef2a2194-5a5c-4eca-bac2-3d79fbeac9a7","parentUuid":"c21e449e-8b43-403f-be68-dcb9e3abe7ba","uuid":"6c0d7333-efb3-45a8-8c1b-e6445f588d01"},{"content":{"advice":{"changed":true,"value":"Repository URLs can break: accounts get renamed, projects move, groups are archived. Without a PID, a paper citing this software can point at nothing within a few years. Minting a DOI with Zenodo is a low effort setup."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":true,"value":[{"measure":0,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":0.5},{"measure":0,"metricUuid":"f6694694-75c5-443a-b925-c5d8480becf3","weight":0.5},{"measure":0,"metricUuid":"c23f39d1-907b-4a54-9add-51f7254b3561","weight":1}]}},"createdAt":"2026-05-10T21:53:21Z","entityUuid":"efbb304a-6196-4cc2-95a9-e7f5c2448a60","parentUuid":"fe9a0536-34a2-4637-82c1-658f281354b3","uuid":"d5a8aa21-5035-4e81-a60c-f8f6e673ba03"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["03e51e53-de92-4de0-834c-f694b70a0218","49bba8ab-1178-4695-a8b6-f8bfa61b1187","54eb01df-650e-41fb-80ac-214f4c6dc4f5","3dfa129e-3b8a-4131-b351-6c6bd9a44d5b"]},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":true,"value":[{"measure":1,"metricUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","weight":0.5},{"measure":1,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":1}]}},"createdAt":"2026-05-10T21:53:22Z","entityUuid":"f0f36a7f-eea0-4d10-b0e6-4f5d36964b63","parentUuid":"b419724b-9b15-4cf1-8ce8-66293b8b924f","uuid":"4d29999f-25d5-46c2-9752-e92339717dc9"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":true,"value":[{"measure":1,"metricUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","weight":0.5},{"measure":1,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":0.5}]}},"createdAt":"2026-05-10T21:53:23Z","entityUuid":"f19b606d-9a52-4452-8257-5af5707318a5","parentUuid":"54eb01df-650e-41fb-80ac-214f4c6dc4f5","uuid":"5bf13d60-06e9-4ab3-b6ca-bb70e68a2c3c"},{"content":{"advice":{"changed":false}