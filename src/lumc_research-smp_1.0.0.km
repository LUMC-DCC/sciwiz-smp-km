:true,"value":[]},"itemTemplateQuestionUuids":{"changed":true,"value":["2b866260-4480-4538-9500-b4a6600253fc","27556679-d360-461d-ab10-b648beab06e9"]},"questionType":"ListQuestion","referenceUuids":{"changed":true,"value":[]},"requiredPhaseUuid":{"changed":true,"value":"de478e18-2a3e-4349-804c-f1d8974897b1"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564"]},"text":{"changed":true,"value":"List the concrete systems or contact routes used for bug reports, feature requests, or support. Add direct URLs where possible."},"title":{"changed":true,"value":"Bug reporting & feature request systems"}},"createdAt":"2026-05-10T21:55:23Z","entityUuid":"1887f4e1-3393-4043-b51c-967cc8b877e9","parentUuid":"b2b8e508-7d90-4a58-8e6b-7700e0f1b457","uuid":"1eebea76-0510-4ed5-b537-49a64ecc2e65"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"questionType":"ValueQuestion","referenceUuids":{"changed":true,"value":[]},"requiredPhaseUuid":{"changed":true,"value":"de478e18-2a3e-4349-804c-f1d8974897b1"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564"]},"text":{"changed":false},"title":{"changed":true,"value":"Standard"},"validations":{"changed":true,"value":[]},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2026-05-10T21:55:24Z","entityUuid":"1970aefe-8332-4e09-8389-6b1c0127fae0","parentUuid":"eb80e4df-360e-49d5-ab03-45054ba6f7e3","uuid":"7e3da9bc-e1ef-4902-9931-3c8bfa2213ba"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":true,"value":["fca49974-b316-4e81-a40f-07da5f053860","3c899e01-79fa-422b-baba-125d3d7efa2b","ccdee4ad-550f-4937-9661-c370e8f01ff9","25817d54-e775-4f92-a3e5-00842790f9b5"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"questionType":"OptionsQuestion","referenceUuids":{"changed":true,"value":["781f2802-bc79-428b-860b-741bc57126da"]},"requiredPhaseUuid":{"changed":true,"value":"de478e18-2a3e-4349-804c-f1d8974897b1"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564"]},"text":{"changed":true,"value":"Does the project ship a complete environment specification beyond the language-level dependency manifest? Three patterns, in increasing rigor:\n\n- Lock-file plus README narrative.\n- Container image (Dockerfile, Apptainer recipe): gold standard, executable documentation.\n- Whole-environment spec (Nix, Pixi): bit-for-bit reproducibility.\n\n"},"title":{"changed":true,"value":"Containerization / environment specification"}},"createdAt":"2026-05-10T21:55:25Z","entityUuid":"1bc785f1-ee01-49b0-8c20-fa7578096490","parentUuid":"ba141448-f70d-4c95-b42c-be93a392936e","uuid":"db01b7ea-d588-4c81-82d3-cd1b472fc5cc"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"questionType":"ValueQuestion","referenceUuids":{"changed":true,"value":[]},"requiredPhaseUuid":{"changed":true,"value":"fd08c186-34f3-4104-8715-702e8623393c"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564","f137aaf2-c1a7-429b-b498-2c80eb9f2a7d"]},"text":{"changed":true,"value":"PubMed Identifier (PMID)."},"title":{"changed":true,"value":"PMID"},"validations":{"changed":true,"value":[]},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2026-05-10T21:55:26Z","entityUuid":"1d90cf0e-46b9-4198-a0e5-3053cbd6335d","parentUuid":"6b175013-2200-4a1f-956a-98b6fba946ec","uuid":"7b4c67c4-b4e3-440e-9672-fb27f879ebd3"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"questionType":"ValueQuestion","referenceUuids":{"changed":true,"value":[]},"requiredPhaseUuid":{"changed":true,"value":"de478e18-2a3e-4349-804c-f1d8974897b1"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564"]},"text":{"changed":true,"value":"How will users install the software?\n\nCommon channels: language package manager (PyPI / conda-forge / CRAN / Bioconductor / npm / crates.io); container image (Docker Hub / GitHub Container Registry / Quay / Apptainer Library / Biocontainers); source-only (`git clone && pip install -e .`); self-hosted installer; hosted as a service (the user calls your API)."},"title":{"changed":true,"value":"Distribution channels"},"validations":{"changed":true,"value":[]},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2026-05-10T21:55:27Z","entityUuid":"1dd35b08-4394-44e5-a2e2-0d35228f6fd4","parentUuid":"52a2dd0c-58ea-435c-b235-af77b1275d0c","uuid":"cc3ab30d-e2de-439d-9b77-0b8056c9fcfc"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"questionType":"ValueQuestion","referenceUuids":{"changed":true,"value":["7a739af4-277b-47d5-a918-88ab6b98f9f0"]},"requiredPhaseUuid":{"changed":true,"value":"a664ce2c-83b0-411a-bdf5-4f829a4ecc25"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e"]},"text":{"changed":true,"value":"Estimate the development effort needed to reach a usable version of the software. Use a unit that fits the project: person-days, person-months, FTE over time, sprint count, student project duration, or grant work-package effort.\n\n**Recommended format**: `<FTE-fraction> for <duration>`, e.g., *0.5 FTE for 18 months* or *1.0 FTE-month one-off*. Order-of-magnitude is enough."},"title":{"changed":true,"value":"Development effort"},"validations":{"changed":true,"value":[]},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2026-05-10T21:55:28Z","entityUuid":"1e0f8cf3-1c0b-4d2c-aeb9-6c4e203ca7a1","parentUuid":"222b5f2e-0b72-4e5c-b1ec-ac1e5f88bacf","uuid":"b66f4781-c9e8-42fb-921f-38b9b6378dea"},{"co