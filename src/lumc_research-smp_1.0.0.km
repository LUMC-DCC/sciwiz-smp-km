ls.name }}, {{ item.locations[0].geonames_details.country_name }}{% endif %}"},"responseListField":{"changed":true,"value":"items"},"testQ":{"changed":true,"value":"Leiden University Medical Center"},"testResponse":{"changed":false},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2026-05-10T21:51:13Z","entityUuid":"827b88ac-8012-4383-8971-9593d02fd52c","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"c4de588d-7453-4934-998f-82e19402e373"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":true,"value":"Funder Crossref"},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":true,"value":null},"requestHeaders":{"changed":true,"value":[{"key":"Accept","value":"application/json"}]},"requestMethod":{"changed":true,"value":"GET"},"requestUrl":{"changed":true,"value":"https://api.crossref.org/funders?query={{ q }}&rows=20"},"responseItemTemplate":{"changed":true,"value":"{{ item.uri }}"},"responseItemTemplateForSelection":{"changed":true,"value":"**{{ item.name }}**{% if item.location %} - {{ item.location }}{% endif %}"},"responseListField":{"changed":true,"value":"message.items"},"testQ":{"changed":true,"value":"Nederlandse Organisatie voor Wetenschappelijk Onderzoek"},"testResponse":{"changed":false},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2026-05-10T21:51:14Z","entityUuid":"9f07d17f-a662-4471-aff4-7d25c24c03ce","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"cc56975c-ca9c-485b-9f5b-9ffe8b2a6a0b"},{"content":{"allowCustomReply":{"changed":false},"annotations":{"changed":false},"eventType":"EditIntegrationEvent","integrationType":"ApiIntegration","name":{"changed":true,"value":"DOI Publications"},"requestAllowEmptySearch":{"changed":false},"requestBody":{"changed":true,"value":null},"requestHeaders":{"changed":true,"value":[{"key":"Accept","value":"application/json"}]},"requestMethod":{"changed":true,"value":"GET"},"requestUrl":{"changed":true,"value":"https://api.crossref.org/works?query.bibliographic={{ q }}&rows=20&select=DOI,author,published,title,container-title"},"responseItemTemplate":{"changed":true,"value":"https://doi.org/{{ item.DOI }}"},"responseItemTemplateForSelection":{"changed":true,"value":"{% if item.author %}{{ item.author[0].family }}{% if item.author|length > 1 %} et al.{% endif %} {% endif %}{% if item.published %}({{ item.published[\"date-parts\"][0][0] }}). {% endif %}**{{ item.title[0] }}**{% if item[\"container-title\"] %}. *{{ item[\"container-title\"][0] }}*{% endif %}"},"responseListField":{"changed":true,"value":"message.items"},"testQ":{"changed":true,"value":"https://doi.org/10.1016/j.neuroimage.2025.121418"},"testResponse":{"changed":false},"testVariables":{"changed":false},"variables":{"changed":false}},"createdAt":"2026-05-10T21:51:15Z","entityUuid":"791745bb-8f12-4491-a591-b451bac75e91","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"c41dbad3-5723-4e00-b913-5c8ff8185bb8"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["68f0beb6-eaf7-4f1a-b7a3-b6cc0c875a38","8579e570-735f-4c1d-be06-7f5e6803dfe1","836d498f-5140-4877-9ef8-de2e656e5655","c21e449e-8b43-403f-be68-dcb9e3abe7ba","a4cb241a-5f76-4850-b783-d62bb36db4cd","d6d0744c-c21c-454c-a17e-f7be0ae12f58","01a015c3-db75-4376-a04f-95c947bff24b"]},"text":{"changed":true,"value":"> Throughout the SMP, present-tense questions (\"Is…\", \"Does…\", \"Has…\") describe the intended state at the relevant project phase. For projects in planning, read these as \"is or will be\"; for active or maintenance projects, read them at face value. The phase tag on each question shows when the answer is normally expected to harden into a concrete reference.\n\nIdentify the project, the people responsible, and any external regulatory regime that applies. Keep this section short: detail belongs in the thematic chapters that follow.\n\nIf you're unsure about the management level (A / B / C) you've selected for the project, see the [management level guidelines](https://lumc-dcc.github.io/rs-guidelines/go/management-levels/) before proceeding."},"title":{"changed":true,"value":"General"}},"createdAt":"2026-05-10T21:51:16Z","entityUuid":"a86be77f-e97d-49f9-a5f3-4af5105367e3","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"c4a2cd18-835a-4f32-b173-8df28be80b52"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["4a580662-68da-4401-a624-2a654b5aa544","a85bf09e-c40a-4849-9306-3efd72c8043d","e0da89c9-fba6-43fc-93ac-7424643269c9","0789a004-5276-41d3-9766-ce8a43a3f7ae","76472d8f-df59-49fc-8726-9091e0c930a0","0fe887b5-a6eb-497b-ab6a-05c0c362a59b","c177f774-cda9-44e5-bb7a-03dea1580664"]},"text":{"changed":true,"value":"Why does this software exist, and for whom? Funders, reviewers, and your future self all start here. Be concrete: prefer specific examples over abstract claims."},"title":{"changed":true,"value":"Motivation"}},"createdAt":"2026-05-10T21:51:17Z","entityUuid":"2f8a5871-b095-4c59-962d-9609220c2f0a","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"242d484d-13c3-49c3-bb4e-03888b8fb6d8"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["9ffa6c58-87eb-41cc-b161-39501bf4a4a3","8eb03e74-d9d9-49ca-9f7f-4d15c8b85874","67de93e1-e02c-4cef-ac98-91468f03006e","1e3700a0-0ebe-4499-a95c-caa6eb2b2974"]},"text":{"changed":true,"value":"Identify what can go wrong and decide what you'll do about it. This chapter is about risk awareness and proportionate mitigation, not risk prediction; you are not expected to enumerate every future failure mode, just the ones whose probability × impact is high enough that ignoring them would be reckless.\n\n**This SMP does not replace the LUMC Data Management Plan (DMP).** Data-protection details (legal basis, retention, DPIA outcomes) belong in the DMP. The Risks chapter only flags that the software touches such concerns and points to the right document or person."},"title":{"changed":true,"value":"Risks"}},"createdAt":"2026-05-10T21:51:18Z","entityUuid":"93c0dcb5-0d56-44af-8b2d-10c4fbef13ef","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"61eefe46-c4da-4646-9220-07b28be6d040"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["15094ec5-2f5b-4bcb-944e-5c76b70f9975","9bbd58d5-d341-4d4a-b790-2127c5abe948","20ecbd93-d2cf-4903-a845-fe8766f44ad7","1e0f8cf3-1c0b-4d2c-aeb9-6c4e203ca7a1","d98ca02c-02d1-42a9-97fa-c549d25f3e3b","0a31022a-9c47-4039-933f-033f74d822db","e3f669c3-3055-4bb5-83df-767a52630d37"]},"text":{"changed":true,"value":"Plan resources for three phases of the software's life: development, maintenance, and retirement. Estimates are fine. The goal is to make resource needs explicit so that shortfalls are visible and not deferred."},"title":{"changed":true,"value":"Planning"}},"createdAt":"2026-05-10T21:51:19Z","entityUuid":"222b5f2e-0b72-4e5c-b1ec-ac1e5f88bacf","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"b9bfad84-c0a4-4cd4-8c10-95b45798226c"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["bcd77cf1-06b8-4867-a7a5-3dcdf5f72b04","fffa48cd-dd60-4c7c-a7de-61f4799f936e","fe9a0536-34a2-4637-82c1-658f281354b3","c8c95984-07e6-438c-abfd-00b8f7a669c0","a844a241-ddd1-49bd-b98b-0548689547e4","056a24f7-9201-4add-a339-5abff6137c59","2f2fec5d-27f6-4a0f-9196-d848a4dfb5cd"]},"text":{"changed":true,"value":"How do people find, retrieve and legally use your software? This chapter covers repository, registries, identifiers, citation, and the license."},"title":{"changed":true,"value":"Licensing & accessibility"}},"createdAt":"2026-05-10T21:51:20Z","entityUuid":"d93d3f14-7bab-440c-8369-d9f6b299e976","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"857091e3-a999-48d3-9b2e-fe44a296b658"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["86a05257-2a79-4779-9ed6-1e1c02061f60","21768d54-f8f8-4329-a706-ab7a008b6ea6","6eb788b0-bcae-4152-b8ee-8cb97bf5c692","afa46dc9-6ca3-4924-aa15-bd015b070cfa","33bc112f-ea2a-402a-92c5-b0eec540e684","45fdb03d-666c-487b-852d-70a2a8b0b922","ce3cc455-a9c7-4c83-b077-15e43b789071","798fc49b-7e46-47ee-8eaa-65c82ffef312"]},"text":{"changed":true,"value":"Documentation is the most-cited reason that scientific software stops being usable. This chapter covers user-, deployment- and developer-facing documentation, plus the community artefacts that make collaboration possible (code of conduct, contributing guidelines, governance)."},"title":{"changed":true,"value":"Documentation & community"}},"createdAt":"2026-05-10T21:51:21Z","entityUuid":"bc0b7898-1dd3-4dc2-8879-ffa3f6ea4c8e","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"5977312c-92a7-401b-aba8-1a3aeb720be5"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["d5af5796-82a6-4450-8e78-02f3d4ec049b","ed5d2980-ecaa-4654-a6a8-8a8dff5920fb","06b6d6d9-5942-4a2a-aecb-6bc9336505e3","6728ef06-49f0-481b-b337-8fc54d63ce6c","292e1a9c-0f32-4338-b558-1ea17e23cbb5","48321dbc-9069-437a-8a71-0fd37ab2d226","1bc785f1-ee01-49b0-8c20-fa7578096490"]},"text":{"changed":true,"value":"How does the software talk to the rest of the world: which languages, which data formats, which platforms?"},"title":{"changed":true,"value":"Interoperability"}},"createdAt":"2026-05-10T21:51:22Z","entityUuid":"ba141448-f70d-4c95-b42c-be93a392936e","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"ab42bb39-b10b-4681-b61d-61c858b18dce"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["b419724b-9b15-4cf1-8ce8-66293b8b924f","3bef6b81-1655-42ea-9d79-0d225b6404ef","a96f0cb4-6796-40e2-be52-88331d9ce1a9","145b6a9a-c428-4603-9065-378139d0dc03"]},"text":{"changed":true,"value":"How do you (and a future maintainer) know the software still does what it is supposed to do? This chapter covers tests, CI, code quality, and the tooling that keeps a project reproducible."},"title":{"changed":true,"value":"Testing & quality assurance"}},"createdAt":"2026-05-10T21:51:23Z","entityUuid":"718c82b8-f655-4265-9b6d-b7e37e66ad6b","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"eb3c2740-868f-4fe9-85b5-05f4747e7bef"},{"content":{"annotations":{"changed":false},"eventType":"EditChapterEvent","questionUuids":{"changed":true,"value":["73fcea4f-2631-4e91-8f79-ccf56dbb04b4","81cb4c8a-451a-4dcf-af86-dac5570ffb2f","271bde84-6f27-4968-9261-94817f483c22"]},"text":{"changed":true,"value":"How is the project versioned, released and distributed?"},"title":{"changed":true,"value":"Versioning & release management"}},"createdAt":"2026-05-10T21:51:24Z","entityUuid":"f9f0867d-8ce4-4985-8c2c-966593149fdf","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"74e37f04-d32f-4e1a-b786-5c6463a8e46d"},{"content":{"abbreviation":{"changed":true,"value":"FAIR-F"},"annotations":{"changed":false},"description":{"changed":true,"value":"How findable the software and its metadata are: by humans through search engines, by machines through indices, and by reviewers through stable identifiers.\n\n> The score is computed as: score = Σ(weight × measure) / Σ(weight) over all **answered** questions that contribute to this metric. Each answer's measure is set on the answer itself; weights are set per (question, metric) pair. Skipped questions don't count. The result is in [0, 1]; the SMP report renders it as a percentage. Treat metric scores as a navigation aid, not a certification. Overall scores are only comparable between plans of comparable completeness."},"eventType":"EditMetricEvent","title":{"changed":true,"value":"FAIR4RS - Findability"}},"createdAt":"2026-05-10T21:51:25Z","entityUuid":"c23f39d1-907b-4a54-9add-51f7254b3561","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"0ea611be-c1d9-4228-bc2f-9855486dbc83"},{"content":{"abbreviation":{"changed":true,"value":"FAIR-A"},"annotations":{"changed":false},"description":{"changed":true,"value":"Whether the software is retrievable, by both humans and machines, using standard open protocols.\n\n> The score is computed as: score = Σ(weight × measure) / Σ(weight) over all **answered** questions that contribute to this metric. Each answer's measure is set on the answer itself; weights are set per (question, metric) pair. Skipped questions don't count. The result is in [0, 1]; the SMP report renders it as a percentage. Treat metric scores as a navigation aid, not a certification. Overall scores are only comparable between plans of comparable completeness."},"eventType":"EditMetricEvent","title":{"changed":true,"value":"FAIR4RS - Accessibility"}},"createdAt":"2026-05-10T21:51:26Z","entityUuid":"f6694694-75c5-443a-b925-c5d8480becf3","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"42932025-b09c-4b04-a637-308a406979f9"},{"content":{"abbreviation":{"changed":false},"annotations":{"changed":false},"description":{"changed":true,"value":"Whether the software's languages, formats, and interfaces are standard, documented, and machine-tractable enough to be combined with other tools.\n\n> The score is computed as: score = Σ(weight × measure) / Σ(weight) over all **answered** questions that contribute to this metric. Each answer's measure is set on the answer itself; weights are set per (question, metric) pair. Skipped questions don't count. The result is in [0, 1]; the SMP report renders it as a percentage. Treat metric scores as a navigation aid, not a certification. Overall scores are only comparable between plans of comparable completeness."},"eventType":"EditMetricEvent","title":{"changed":true,"value":"FAIR4RS - Interoperability"}},"createdAt":"2026-05-10T21:51:27Z","entityUuid":"1f542bcf-d008-483e-a101-4509fb14fe81","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"fac18b60-d0e6-4959-acd2-a1040617068c"},{"content":{"abbreviation":{"changed":true,"value":"FAIR-R"},"annotations":{"changed":false},"description":{"changed":true,"value":"Whether someone else (or your future self) can install, run, modify, test, and cite the software.\n\n> The score is computed as: score = Σ(weight × measure) / Σ(weight) over all **answered** questions that contribute to this metric. Each answer's measure is set on the answer itself; weights are set per (question, metric) pair. Skipped questions don't count. The result is in [0, 1]; the SMP report renders it as a percentage. Treat metric scores as a navigation aid, not a certification. Overall scores are only comparable between plans of comparable completeness."},"eventType":"EditMetricEvent","title":{"changed":true,"value":"FAIR4RS - Reusability"}},"createdAt":"2026-05-10T21:51:28Z","entityUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"ecceea56-cde8-4792-9020-fa1831ca1fe3"},{"content":{"abbreviation":{"changed":false},"annotations":{"changed":false},"description":{"changed":true,"value":"The practical free-and-open-source-software properties, distinct from FAIR. Read broadly: as well as license and source availability, this covers the practices that make an open project usable by outsiders. A project can be partly FAIR and not FOSS (closed but well-documented), or FOSS and partly FAIR.\n\n> The score is computed as: score = Σ(weight × measure) / Σ(weight) over all **answered** questions that contribute to this metric. Each answer's measure is set on the answer itself; weights are set per (question, metric) pair. Skipped questions don't count. The result is in [0, 1]; the SMP report renders it as a percentage. Treat metric scores as a navigation aid, not a certification. Overall scores are only comparable between plans of comparable completeness.\n\n"},"eventType":"EditMetricEvent","title":{"changed":true,"value":"FOSS"}},"createdAt":"2026-05-10T21:51:29Z","entityUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","parentUuid":"00000000-0000-0000-0000-000000000000","uuid":"8703d597-0d51-4b52-a38b-98fc6d67b54e"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"First steps before writing code: scope, motivation, risks, audience, resources."},"eventType":"EditPhaseEvent","title":{"changed":true,"value":"Ideation"}},"createdAt":"2026-05-10T21:51:30Z","entityUuid":"a664ce2c-83b0-411a-bdf5-4f829a4ecc25","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"bde7f586-84a4-4b62-966f-912440b901be"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"Before writing code: scope, motivation, risks, audience, resources, and more specific technical decisions. Useful before submitting a grant proposal and starting active development."},"eventType":"EditPhaseEvent","title":{"changed":true,"value":"Planning"}},"createdAt":"2026-05-10T21:51:31Z","entityUuid":"de478e18-2a3e-4349-804c-f1d8974897b1","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"791f349f-fb6e-4841-bd9f-8583cecd0566"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"While the software is being actively built. Most repository-, license-, version- and test-related answers should now point to concrete URLs or files."},"eventType":"EditPhaseEvent","title":{"changed":true,"value":"Active development"}},"createdAt":"2026-05-10T21:51:32Z","entityUuid":"fd08c186-34f3-4104-8715-702e8623393c","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"9dd3962a-73c8-405a-9d16-a3baca999d76"},{"content":{"annotations":{"changed":false},"description":{"changed":true,"value":"After active development has slowed: bugfix releases, dependency updates, user support. Update the SMP at each new version or when policies change."},"eventType":"EditPhaseEvent","title":{"changed":true,"value":"Maintenance"}},"createdAt":"2026-05-10T21:51:33Z","entityUuid":"92aed7aa-9d45-47f4-8a27-a1261e89aa5d","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"c3e92a07-a1af-45c4-8671-ebe8e62f18ec"},{"content":{"annotations":{"changed":false},"color":{"changed":true,"value":"#3498DB"},"description":{"changed":true,"value":"This software is built for a specific, short-term purpose such as a single analysis or teaching example, with the developer as the main user. It’s small and easy to verify for correctness, often by visual inspection or simple tests. Since it’s not meant for reuse or long-term support, minimal maintenance is needed beyond basic documentation, versioning, and archiving.  (read more doi.org/10.5281/zenodo.7589725)"},"eventType":"EditTagEvent","name":{"changed":true,"value":"Level A"}},"createdAt":"2026-05-10T21:51:34Z","entityUuid":"f137aaf2-c1a7-429b-b498-2c80eb9f2a7d","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"8b22c947-fea6-48e0-b381-f2eddc934405"},{"content":{"annotations":{"changed":false},"color":{"changed":true,"value":"#8E44AD"},"description":{"changed":true,"value":"This software is typically a research output developed for a project but may be useful to others as a tool, module, or library. It should follow solid software practices - like version control, documentation, testing, and packaging - to ensure reliability and reusability. Because it can outlive the project, plans for archiving, citation, and long-term support are necessary.  (read more doi.org/10.5281/zenodo.7589725)"},"eventType":"EditTagEvent","name":{"changed":true,"value":"Level B"}},"createdAt":"2026-05-10T21:51:35Z","entityUuid":"92650c80-a463-4b49-869e-d6cfa63fe564","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"a97cba99-ca23-4c62-9176-a5eded2402dd"},{"content":{"annotations":{"changed":false},"color":{"changed":true,"value":"#E67E22"},"description":{"changed":true,"value":"This software has broad impact or critical use, such as being used by external users or influencing research results, models, or physical systems. Reliability is essential and requires rigorous engineering practices, testing, auditing, and compliance with legal or certification standards. It must be maintained indefinitely, supported by sustainable funding, community involvement, and continuous release pipelines."},"eventType":"EditTagEvent","name":{"changed":true,"value":"Level C"}},"createdAt":"2026-05-10T21:51:36Z","entityUuid":"b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"803af11d-62a3-4691-a177-16ee83581a65"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2026-05-10T21:51:37Z","entityUuid":"00280f4e-d844-4324-9775-fc0b0dfe20ae","parentUuid":"67de93e1-e02c-4cef-ac98-91468f03006e","uuid":"ff6f6495-3d46-43a1-9b8d-c28b53f03396"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"Stable"},"metricMeasures":{"changed":false}},"createdAt":"2026-05-10T21:51:38Z","entityUuid":"00d26d00-d877-462b-b34c-d9df8ec3d503","parentUuid":"c127043f-524b-44b4-93d3-ff3ff82e889e","uuid":"104659cc-580b-4570-aea2-a58c176e9061"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":true,"value":[{"measure":1,"metricUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","weight":0.5},{"measure":1,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":0.5}]}},"createdAt":"2026-05-10T21:51:39Z","entityUuid":"01610ea1-b86c-4d43-aeb3-8ca644ac069e","parentUuid":"11cff4fe-9774-4cde-a6fb-d9e62d977215","uuid":"cb11def9-82c9-4209-8f81-e13ef478aae4"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["8b4d40a6-3be6-40b5-8219-b3f4431a4c40"]},"label":{"changed":true,"value":"User-supplied only"},"metricMeasures":{"changed":false}},"createdAt":"2026-05-10T21:51:40Z","entityUuid":"01ca2df0-f2e3-4615-ac62-c7b9db656bd2","parentUuid":"9ffa6c58-87eb-41cc-b161-39501bf4a4a3","uuid":"5b9e6cb4-5d86-4111-9d2c-7ec15e3411d5"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"Suite"},"metricMeasures":{"changed":false}},"createdAt":"2026-05-10T21:51:41Z","entityUuid":"034a44ad-d580-4a3b-9afc-a3d0bf09c6f3","parentUuid":"3a92e33c-aa40-400f-8e2b-4c4c140090a0","uuid":"8ab56788-7706-4a45-b550-35fa6c17a2b0"},{"content":{"advice":{"changed":true,"value":"**Important!** This SMP is not a substitute for the regulatory artifacts that such software must produce (IEC 62304 software life-cycle records, ISO 14971 risk file, MDR/IVDR technical file, etc.). At LUMC, contact the Techno Infopoint MDR/IVDR (techno-infopoint@lumc.nl) early, and treat this SMP only as a high-level overview that complements your regulated documentation."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":false}},"createdAt":"2026-05-10T21:51:42Z","entityUuid":"03777f3f-14a9-4e86-8cd4-1f92902c16fc","parentUuid":"01a015c3-db75-4376-a04f-95c947bff24b","uuid":"9279ab35-b970-4de9-9216-bfd0033ad301"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"Windows"},"metricMeasures":{"changed":false}},"createdAt":"2026-05-10T21:51:43Z","entityUuid":"04b4dbe1-5434-470a-abf5-4e4061f867e0","parentUuid":"2fb3c356-62c4-457a-b57f-1c6f075ad6fc","uuid":"37687781-8529-40c9-b361-5cec5f2ff870"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["4a33e5b7-3918-4985-897d-04cb2155c1b1","f8442558-628e-437c-a1eb-b4331a85513b","3cef38fd-938e-44f8-bbb7-b27b06ad1cc2"]},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":true,"value":[{"measure":1,"metricUuid":"f6694694-75c5-443a-b925-c5d8480becf3","weight":1},{"measure":1,"metricUuid":"c23f39d1-907b-4a54-9add-51f7254b3561","weight":1}]}},"createdAt":"2026-05-10T21:51:44Z","entityUuid":"082b2cc8-b380-46e3-ba15-1cb69d5be841","parentUuid":"e3f669c3-3055-4bb5-83df-767a52630d37","uuid":"ea144065-3b87-4ae5-9c4f-c2a24439b0a6"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"Best-effort maintenance / no timeline commitment"},"metricMeasures":{"changed":true,"value":[{"measure":0.25,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":0.5}]}},"createdAt":"2026-05-10T21:51:45Z","entityUuid":"0aa89f8d-a1da-4c39-b331-8a1bb05288e0","parentUuid":"2c78ad92-db2e-43d3-b5d1-61ec4b3b1694","uuid":"52808166-73db-417f-a68d-edae58c40255"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":["062bbcb9-2fe7-4e4a-8cf7-a09e5dfd709a"]},"label":{"changed":true,"value":"Yes"},"metricMeasures":{"changed":true,"value":[{"measure":1,"metricUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","weight":1},{"measure":1,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":1}]}},"createdAt":"2026-05-10T21:51:46Z","entityUuid":"0e51b88b-d069-4a67-8299-29b64185ccd2","parentUuid":"73fcea4f-2631-4e91-8f79-ccf56dbb04b4","uuid":"de78072a-5fbe-4e53-9a27-0aafe3000bbd"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"Workflow"},"metricMeasures":{"changed":false}},"createdAt":"2026-05-10T21:51:47Z","entityUuid":"0f4f0ba0-1fd4-4daa-b0df-fd48aa9da030","parentUuid":"3a92e33c-aa40-400f-8e2b-4c4c140090a0","uuid":"2a903701-cfd0-4d36-997a-4be40ce0c701"},{"content":{"advice":{"changed":true,"value":"Acceptable for small one-person scripts, but a risk for continuity if anyone else may maintain the software."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":true,"value":[{"measure":0,"metricUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","weight":0.5},{"measure":0,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":0.5}]}},"createdAt":"2026-05-10T21:51:48Z","entityUuid":"0fa7f210-7fd6-4b7d-a22e-a73232683c2c","parentUuid":"afa46dc9-6ca3-4924-aa15-bd015b070cfa","uuid":"3d30e2d8-9b7d-403a-bac7-23583692470a"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"No"},"metricMeasures":{"changed":false}},"createdAt":"2026-05-10T21:51:49Z","entityUuid":"12a33ddd-ff13-41ff-b84d-e04fb8f23400","parentUuid":"c21e449e-8b43-403f-be68-dcb9e3abe7ba","uuid":"03ddaf6f-4291-46bd-bfa9-8c7dac2a8168"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":true,"value":[]},"label":{"changed":true,"value":"Active/routine maintenance"},"metricMeasures":{"changed":true,"value":[{"measure":1,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":0.5}]}},"createdAt":"2026-05-10T21:51:50Z","entityUuid":"145474ff-6308-482e-a236-6cb92f76e9e7","parentUuid":"2c78ad92-db2e-43d3-b5d1-61ec4b3b1694","uuid":"d6731d4f-66ec-4008-9ce5-