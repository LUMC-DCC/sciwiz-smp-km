stQuestion","referenceUuids":{"changed":true,"value":[]},"requiredPhaseUuid":{"changed":true,"value":"de478e18-2a3e-4349-804c-f1d8974897b1"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564"]},"text":{"changed":true,"value":"List relevant software registries where the software is listed.\nMultiple registries are encouraged: different communities use different ones."},"title":{"changed":true,"value":"Registries list"}},"createdAt":"2026-05-10T21:57:51Z","entityUuid":"ec0874b6-33f9-4572-8178-a0d0f4d48934","parentUuid":"997f565b-293c-4879-8df5-fb38d4007a2e","uuid":"05da3fb4-3370-4f1a-81ee-f85344a3e9a1"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"itemTemplateQuestionUuids":{"changed":true,"value":["bb074a28-a695-45d5-bb70-d5dcf22dc507","b3cc9582-e6db-439f-b702-5b2ca2f6a6d1","d9db3cfe-4487-4ab5-80f7-fe4896e1e393","f8b5d702-1d55-41e3-88a4-f9b7d70daae7","14fdd95b-ed8a-4679-8e1d-47c304f25d01"]},"questionType":"ListQuestion","referenceUuids":{"changed":true,"value":["78154b8b-aaf7-4c90-865c-b7d7ed5786a5","635aa14f-14ce-47e3-96b1-33ce698128e4"]},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","92650c80-a463-4b49-869e-d6cfa63fe564","f137aaf2-c1a7-429b-b498-2c80eb9f2a7d"]},"text":{"changed":true,"value":"List data formats the software can read / import and write, export, or emits. Prefer controlled EDAM format terms (or any open, standard, and documented formats) where available. Specify any constraint a format must satisfy beyond the format itself, e.g., required columns, coordinate system, reference build. Include constraints only when they matter for interoperability.\n\nIn Functions question below, split the formats into input and output per function.\n\n"},"title":{"changed":true,"value":"Data formats"}},"createdAt":"2026-05-10T21:57:52Z","entityUuid":"ed5d2980-ecaa-4654-a6a8-8a8dff5920fb","parentUuid":"ba141448-f70d-4c95-b42c-be93a392936e","uuid":"c5aa69aa-0e2c-4013-b2ec-5bcc56bcf762"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"questionType":"ValueQuestion","referenceUuids":{"changed":true,"value":["11a9ddde-790f-45e7-9ab8-6e845cf36bd8"]},"requiredPhaseUuid":{"changed":true,"value":"de478e18-2a3e-4349-804c-f1d8974897b1"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e"]},"text":{"changed":true,"value":"What is the contingency plan if something fails? What are the responsibilities, escalation procedures, and commitments in the event of a failure?\nMitigations don't have to be elaborate. Check with your departmental SOP, if available."},"title":{"changed":true,"value":"Mitigation"},"validations":{"changed":true,"value":[]},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2026-05-10T21:57:53Z","entityUuid":"ed90b3d1-b082-4156-b7d4-c7084e88e495","parentUuid":"98569a9f-cf37-4451-9d20-4836b8187578","uuid":"35eed4dd-5ae8-4803-8ccc-ddbbad89fb50"},{"content":{"annotations":{"changed":false},"choiceUuids":{"changed":true,"value":["d8b1fa9d-a9c9-4155-a79a-35a338585643","2198eb33-2e7f-4a90-87a7-2ce419cc2a19","9eb1482b-b995-4767-9e46-637109db9ebb","8c22100a-6321-4ee8-b5b2-9ab4287d22d7","cd4942d7-b397-4b73-b05a-addb48213b30"]},"eventType":"EditQuestionEvent","expertUuids":{"changed":true,"value":[]},"questionType":"MultiChoiceQuestion","referenceUuids":{"changed":true,"value":[]},"requiredPhaseUuid":{"changed":true,"value":"de478e18-2a3e-4349-804c-f1d8974897b1"},"tagUuids":{"changed":true,"value":["b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e"]},"text":{"changed":false},"title":{"changed":true,"value":"Cost coverage"}},"createdAt":"2026-05-10T21:57:54Z","entityUuid":"f460f0e2-d63f-4748-aa3c-5e3d645789af","parentUuid":"9bbd58d5-d341-4d4a-b790-2127c5abe948","uuid":"d422388e-c6e2-4f0a-b541-4ffa3848bc33"},{"content":{"annotations":