e inputs\nStorage    : ~200 MB code; ~5 GB for a representative input dataset\nCompute    : 1–8 CPU cores typical; scales linearly to 32 in batch mode\nGPU        : NVIDIA, ≥ 12 GB VRAM, CUDA ≥ 11.8 (segmentation step only)\nWall clock : ~5 min/subject; ~3 h for a 100-subject cohort on 8 cores\n```"},"title":{"changed":true,"value":"Resource requirements"}},"createdAt":"2026-05-10T22:40:43Z","entityUuid":"48321dbc-9069-437a-8a71-0fd37ab2d226","parentUuid":"ba141448-f70d-4c95-b42c-be93a392936e","uuid":"8af530bb-898c-4bf6-92fe-479e554dcd7c"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2026-05-10T22:40:48Z","entityUuid":"48321dbc-9069-437a-8a71-0fd37ab2d226","parentUuid":"ba141448-f70d-4c95-b42c-be93a392936e","uuid":"3875fc83-b707-4b9b-84ac-c04270956a72"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2026-05-10T22:40:56Z","entityUuid":"1bc785f1-ee01-49b0-8c20-fa7578096490","parentUuid":"ba141448-f70d-4c95-b42c-be93a392936e","uuid":"d7b7f7a5-723d-41f3-9dab-4d7d1ba3de4d"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Does the project ship a complete environment specification beyond the language-level dependency manifest (see Documentation section)? Three patterns, in increasing rigor:\n- Lock-file plus README narrative.\n- Container image (Dockerfile, Apptainer recipe): gold standard, executable documentation.\n- Whole-environment spec (Nix, Pixi, conda-lock): bit-for-bit reproducibility."},"title":{"changed":true,"value":"Containerization / environment specification"}},"createdAt":"2026-05-10T22:40:58Z","entityUuid":"1bc785f1-ee01-49b0-8c20-fa7578096490","parentUuid":"ba141448-f70d-4c95-b42c-be93a392936e","uuid":"6d2f7960-ccdb-4d4c-9b2a-b92a147a26d6"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2026-05-10T22:41:12Z","entityUuid":"fca49974-b316-4e81-a40f-07da5f053860","parentUuid":"1bc785f1-ee01-49b0-8c20-fa7578096490","uuid":"8a3f5658-a3f9-4b4b-8b3b-0653285035e4"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Full environment spec"},"metricMeasures":{"changed":true,"value":[{"measure":1,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":0.5},{"measure":1,"metricUuid":"1f542bcf-d008-483e-a101-4509fb14fe81","weight":1}]}},"createdAt":"2026-05-10T22:41:12Z","entityUuid":"fca49974-b316-4e81-a40f-07da5f053860","parentUuid":"1bc785f1-ee01-49b0-8c20-fa7578096490","uuid":"2fca2b2a-aed7-4660-bbe2-142883231c03"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2026-05-10T22:41:24Z","entityUuid":"3c899e01-79fa-422b-baba-125d3d7efa2b","parentUuid":"1bc785f1-ee01-49b0-8c20-fa7578096490","uuid":"82d1c6e5-fcd4-4517-a1a1-f87e30c9e581"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Dockerfile or equivalent"},"metricMeasures":{"changed":true,"value":[{"measure":0.75,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":0.5},{"measure":0.75,"metricUuid":"1f542bcf-d008-483e-a101-4509fb14fe81","weight":1}]}},"createdAt":"2026-05-10T