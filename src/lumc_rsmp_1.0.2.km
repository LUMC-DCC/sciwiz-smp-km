":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Risk details"}},"createdAt":"2026-05-10T22:03:40Z","entityUuid":"cb88ea86-0ffd-47e1-a3d3-de0da32c6d71","parentUuid":"6ff80d99-bb0e-47e6-a450-4e17f9439424","uuid":"266a2383-6478-47cd-8700-e62aef4aa9f2"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Identify external software, data, hardware or services whose behavior, availability, or license may pose a long-term risk. Be realistic: focus on dependencies that would be expensive to replace, not every transitive package.\n\nFour archetypes worth flagging: vendor lock-in, unstable upstream API, abandoned upstream, proprietary data formats."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2026-05-10T22:03:42Z","entityUuid":"cb88ea86-0ffd-47e1-a3d3-de0da32c6d71","parentUuid":"6ff80d99-bb0e-47e6-a450-4e17f9439424","uuid":"2c6f2ca7-615f-43d6-b3d8-a865b2d12245"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2026-05-10T22:03:56Z","entityUuid":"01f03bbe-009c-4bef-98b3-2dcf3203d15b","parentUuid":"6ff80d99-bb0e-47e6-a450-4e17f9439424","uuid":"659be346-686d-4609-9f5f-4edafdfc72df"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Mitigation"}},"createdAt":"2026-05-10T22:03:56Z","entityUuid":"01f03bbe-009c-4bef-98b3-2dcf3203d15b","parentUuid":"6ff80d99-bb0e-47e6-a450-4e17f9439424","uuid":"7d041ce1-9b85-444e-9a77-511edfc354cb"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"What is the contingency plan if something fails? What are the responsibilities, escalation procedures, and commitments in the event of a failure?\nMitigations don't have to be elaborate."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"TextQuestionValueType"}},"createdAt":"2026-05-10T22:03:59Z","entityUuid":"01f03bbe-009c-4bef-98b3-2dcf3203d15b","parentUuid":"6ff80d99-bb0e-47e6-a450-4e17f9439424","uuid":"d822d836-eecd-451f-bdaa-9a6d06277b3a"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2026-05-10T22:04:36Z","entityUuid":"15094ec5-2f5b-4bcb-944e-5c76b70f9975","parentUuid":"222b5f2e-0b72-4e5c-b1ec-ac1e5f88bacf","uuid":"47c5ab62-6d7f-48db-8bbe-a0e61945c28e"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Infrastructure & hardware"}},"createdAt":"2026-05-10T22:04:36Z","entityUuid":"15094ec5-2f5b-4bcb-944e-5c76b70f9975","parentUuid":"222b5f2e-0b72-4e5c-b1ec-ac1e5f88bacf","uuid":"9dd15057-ecfe-41de-a9c6-af0d102d434c"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"itemTemplateQuestionUuids":{"changed":false},"questionType":"ListQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"What physical or cloud infrastructure and hardware does the project need? E.g.: local servers, HPC allocations (Shark, SURF Snellius), cloud accounts, GPUs (model + VRAM), specialized lab instruments, storage tiers (Research Drive, Object Storage).\n\n**Does NOT include**: version-control hosting, package registries, documentation hosting."},"title":{"changed":false}},"createdAt":"2026-05-10T22:04:38Z","entityUuid":"15094ec5-2f5b-4bcb-944e-5c76b70f9975","parentUuid":"222b5f2e-0b72-4e5c-b1ec-ac1e5f88bacf","uuid":"c694770b-d6ff-44a5-a8b0-528ca55c7c76"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2026-05-10T22:04:50Z","entityUuid":"623297ed-d432-470a-8c78-796472ee64d0","parentUuid":"15094ec5-2f5b-4bcb-944e-5c76b70f9975","uuid":"af9f4e98-5158-4177-b35a-270e93f61a75"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Requirement"}},"createdAt":"2026-05-10T22:04:53Z","entityUuid":"623297ed-d432-470a-8c78-796472ee64d0","parentUuid":"15094ec5-2f5b-4bcb-944e-5c76b70f9975","uuid":"84da9298-4c30-4765-8013-654d6d9cc8a0"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"cha