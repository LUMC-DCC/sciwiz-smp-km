ably: a documentation site (MkDocs, Sphinx+MyST, Quarto, Docusaurus) hosted on Read the Docs / GitHub Pages / GitLab Pages."},"title":{"changed":true,"value":"User documentation"}},"createdAt":"2026-05-10T22:27:42Z","entityUuid":"21768d54-f8f8-4329-a706-ab7a008b6ea6","parentUuid":"bc0b7898-1dd3-4dc2-8879-ffa3f6ea4c8e","uuid":"69ed8cf8-b8b0-46b9-ae05-1d6a955e4861"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2026-05-10T22:27:58Z","entityUuid":"761cafd5-2de5-4a0c-a0f4-214c0bb64f41","parentUuid":"21768d54-f8f8-4329-a706-ab7a008b6ea6","uuid":"10d53749-de6b-4112-b349-c73f83c07cbf"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes - full doc"},"metricMeasures":{"changed":true,"value":[{"measure":1,"metricUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","weight":1},{"measure":1,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":1}]}},"createdAt":"2026-05-10T22:27:58Z","entityUuid":"761cafd5-2de5-4a0c-a0f4-214c0bb64f41","parentUuid":"21768d54-f8f8-4329-a706-ab7a008b6ea6","uuid":"bf190da0-fa31-43ee-b5a3-7e64ae67d696"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2026-05-10T22:28:09Z","entityUuid":"fedf4a6d-b844-4245-be08-dec92afeabef","parentUuid":"21768d54-f8f8-4329-a706-ab7a008b6ea6","uuid":"6ea3e9df-ed96-4e61-add6-f9a49ef40c6f"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes - README only"},"metricMeasures":{"changed":true,"value":[{"measure":0.5,"metricUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","weight":1},{"measure":0.5,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":1}]}},"createdAt":"2026-05-10T22:28:09Z","entityUuid":"fedf4a6d-b844-4245-be08-dec92afeabef","pare