:false},"requiredPhaseUuid":{"changed":true,"value":"de478e18-2a3e-4349-804c-f1d8974897b1"},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":false}},"createdAt":"2026-05-10T23:09:21Z","entityUuid":"1dd35b08-4394-44e5-a2e2-0d35228f6fd4","parentUuid":"52a2dd0c-58ea-435c-b235-af77b1275d0c","uuid":"32cb1a1e-863c-4302-ab1f-f36b2679a149"}],"forkOfPackageId":null,"id":"lumc:rsmp:0.0.2","kmId":"rsmp","license":"CC-BY 4.0 ","mergeCheckpointPackageId":null,"metamodelVersion":20,"name":"LUMC-DCC Software Management Plan","nonEditable":false,"organizationId":"lumc","phase":"ReleasedKnowledgeModelPackagePhase","previousPackageId":"lumc:rsmp:0.0.1","readme":"# SMP knowledge model","version":"0.0.2"},{"createdAt":"2026-05-10T23:20:38.665166Z","description":"A Knowledge Model for creating Software Management Plans (SMPs) ","events":[{"content":{"annotations":[],"color":"","description":null,"eventType":"AddTagEvent","name":""},"createdAt":"2026-05-10T23:10:10Z","entityUuid":"f137aaf2-c1a7-429b-b498-2c80eb9f2a7d","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"fe6efd64-59f6-4dd3-ace5-a28e8ee28437"},{"content":{"annotations":{"changed":false},"color":{"changed":true,"value":"#3498DB"},"description":{"changed":true,"value":"This software is built for a specific, short-term purpose such as a single analysis or teaching example, with the developer as the main user. It’s small and easy to verify for correctness, often by visual inspection or simple tests. Since it’s not meant for reuse or long-term support, minimal maintenance is needed beyond basic documentation, versioning, and archiving.  (read more doi.org/10.5281/zenodo.7589725)"},"eventType":"EditTagEvent","name":{"changed":true,"value":"Level A"}},"createdAt":"2026-05-10T23:10:10Z","entityUuid":"f137aaf2-c1a7-429b-b498-2c80eb9f2a7d","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"748a4c64-3a0b-4758-8fae-7808194f6d1d"},{"content":{"annotations":[],"color":"","description":null,"eventType":"AddTagEvent","name":""},"createdAt":"2026-05-10T23:10:22Z","entityUuid":"92650c80-a463-4b49-869e-d6cfa63fe564","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"5d6dc99b-cac8-4bf9-82f3-0e23764ec60e"},{"content":{"annotations":{"changed":false},"color":{"changed":true,"value":"#8E44AD"},"description":{"changed":true,"value":"This software is typically a research output developed for a project but may be useful to others as a tool, module, or library. It should follow solid software practices - like version control, documentation, testing, and packaging - to ensure reliability and reusability. Because it can outlive the project, plans for archiving, citation, and long-term support are necessary.  (read more doi.org/10.5281/zenodo.7589725)"},"eventType":"EditTagEvent","name":{"changed":true,"value":"Level B"}},"createdAt":"2026-05-10T23:10:22Z","entityUuid":"92650c80-a463-4b49-869e-d6cfa63fe564","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"5d5e6d36-0919-44d9-88d6-167d087397d9"},{"content":{"annotations":[],"color":"","description":null,"eventType":"AddTagEvent","name":""},"createdAt":"2026-05-10T23:10:31Z","entityUuid":"b3e257d2-eaaf-4d22-89c9-3024eb7f2f3e","parentUuid":"414f5370-df93-4b98-8289-58b881d81ceb","uuid":"94f7bdf3-b08d-4c22-8e92-49c3103cffaa"},{"content":{"annotations":{"changed":false},"color":{"changed":true,"value":"#E67E22"},"description":{"changed":true,"value":"This software has broad impact or critical use, such as being used by external users or influencing research results, models, or physical systems. Reliability is essential and requires rigorous engineering practices, testing, auditing, and compliance with legal or certification standards. It must be maintained indefinitely, supported by sustainable funding, community involvement, and continuous release pipelines."},"eventType":"EditTagEvent","name":{"changed":true,"value":"Level C"}},"createdAt":"2026-05