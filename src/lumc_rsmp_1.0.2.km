stion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"E.g.: External Slack support contract, DCC consultancy, Snellius CPU allocation."},"title":{"changed":true,"value":"Service / partner"}},"createdAt":"2026-05-10T22:05:57Z","entityUuid":"fd4eb5dd-e059-4666-816b-4d08f140f832","parentUuid":"9bbd58d5-d341-4d4a-b790-2127c5abe948","uuid":"7de3ecf8-bb8f-41cd-a6ae-ec6096c6a05d"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2026-05-10T22:06:02Z","entityUuid":"fd4eb5dd-e059-4666-816b-4d08f140f832","parentUuid":"9bbd58d5-d341-4d4a-b790-2127c5abe948","uuid":"b77b2535-6fd4-4c81-9812-82ba6e44dacf"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2026-05-10T22:06:09Z","entityUuid":"795ca27f-6d0f-4e62-a9b1-0ad2b8845ca3","parentUuid":"9bbd58d5-d341-4d4a-b790-2127c5abe948","uuid":"8cc606c8-b619-4df0-8f25-6f66ec2592e9"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Organization or platform responsible for the service."},"title":{"changed":true,"value":"Provider"}},"createdAt":"2026-05-10T22:06:11Z","entityUuid":"795ca27f-6d0f-4e62-a9b1-0ad2b8845ca3","parentUuid":"9bbd58d5-d341-4d4a-b790-2127c5abe948","uuid":"50fd19d2-5999-40cc-83ce-4b9b1ee19791"},{"content":{"annotations":