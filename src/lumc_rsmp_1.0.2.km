4add-a339-5abff6137c59","uuid":"1516ccc2-3e15-4331-8a1f-ac3e06172370"},{"content":{"advice":{"changed":true,"value":"If you publish code without a license, you're keeping all rights reserved by default. That means nobody else (sometimes even you) has permission to use, modify, share, or extend your work even if it's publicly visible. Just compiling or running the software can constitute a violation. [Read more](https://choosealicense.com/no-permission/) about the implications of not licensing your software."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":false},"metricMeasures":{"changed":true,"value":[{"measure":0,"metricUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","weight":1},{"measure":0,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":1},{"measure":0,"metricUuid":"f6694694-75c5-443a-b925-c5d8480becf3","weight":1}]}},"createdAt":"2026-05-10T22:24:52Z","entityUuid":"4409e72b-39f4-47e9-88aa-c61ccb85e186","parentUuid":"056a24f7-9201-4add-a339-5abff6137c59","uuid":"4df26226-3ad5-45d4-8291-70852aee652e"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2026-05-10T22:25:22Z","entityUuid":"aebefa3a-9909-4de4-8d9e-fc550500f9ee","parentUuid":"ce2b567a-da20-43be-a121-e677415a8e0c","uuid":"70e7b058-5f77-4e70-a114-caf88013a691"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":false},"title":{"changed":true,"value":"Software license type"}},"createdAt":"2026-05-10T22:25:25Z","entityUuid":"aebefa3a-9909-4de4-8d9e-fc550500f9ee","parentUuid":"ce2b567a-da20-43be-a121-e677415a8e0c","uuid":"f6d51466-4b12-40c8-af13-b4f9a917402f"},{"content":{"annotations":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"ValueQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Pick the license (use the [SPDX identifier](https://spdx.org/licenses/): `Apache-2.0`, not `Apache 2.0`). \nLUMC default: **\"as open as possible, as closed as necessary\"**.\nRecommended license: [Apache-2.0](https://www.apache.org/licenses/LICENSE-2.0)."},"title":{"changed":false},"validations":{"changed":false},"valueType":{"changed":true,"value":"StringQuestionValueType"}},"createdAt":"2026-05-10T22:25:30Z","entityUuid":"aebefa3a-9909-4de4-8d9e-fc550500f9ee","parentUuid":"ce2b567a-da20-43be-a121-e677415a8e0c","uuid":"294a95bc-abf1-4ae9-90c2-88110cbe5ec1"},{"content":{"annotations":[],"eventType":"AddQuestionEvent","questionType":"OptionsQuestion","requiredPhaseUuid":null,"tagUuids":[],"text":null,"title":""},"createdAt":"2026-05-10T22:25:52Z","entityUuid":"8fe87903-df9b-4e85-8f80-471a46e20e59","parentUuid":"ce2b567a-da20-43be-a121-e677415a8e0c","uuid":"33ceaf0c-6192-4906-a674-3341edc36e65"},{"content":{"annotations":{"changed":false},"answerUuids":{"changed":false},"eventType":"EditQuestionEvent","expertUuids":{"changed":false},"questionType":"OptionsQuestion","referenceUuids":{"changed":false},"requiredPhaseUuid":{"changed":false},"tagUuids":{"changed":false},"text":{"changed":true,"value":"Do you check if your dependencies' licenses are compatible with your project's license?\n\nLicense compatibility means the licenses of your project and its dependencies don't conflict legally. It matters when you use third-party code, such as libraries or modules, because incompatible licenses can block you from distributing your software, force you to adopt more restrictive terms, or even introduce legal risk.\n\nTooling: licensecheck / pip-licenses (Python), cargo-deny (Rust), license-checker (Node), FOSSA / Snyk / GitHub Advanced Security (cross-language)."},"title":{"changed":true,"value":"License compatibility"}},"createdAt":"2026-05-10T22:25:52Z","entityUuid":"8fe87903-df9b-4e85-8f80-471a46e20e59","parentUuid":"ce2b567a-da20-43be-a121-e677415a8e0c","uuid":"1b5790c2-e5d6-4548-ba5d-4e24675949ff"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2026-05-10T22:26:03Z","entityUuid":"f4cf03cd-6b28-41a5-b1ee-0e510f9c51e5","parentUuid":"8fe87903-df9b-4e85-8f80-471a46e20e59","uuid":"cb4685a8-4ac2-4b54-98f7-5ebe8a487296"},{"content":{"advice":{"changed":false},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes - automated tooling"},"metricMeasures":{"changed":true,"value":[{"measure":1,"metricUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","weight":0.5},{"measure":1,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":0.5}]}},"createdAt":"2026-05-10T22:26:06Z","entityUuid":"f4cf03cd-6b28-41a5-b1ee-0e510f9c51e5","parentUuid":"8fe87903-df9b-4e85-8f80-471a46e20e59","uuid":"b8388d18-a271-4df7-8299-6a941c7fa5fa"},{"content":{"advice":null,"annotations":[],"eventType":"AddAnswerEvent","label":"","metricMeasures":[]},"createdAt":"2026-05-10T22:26:24Z","entityUuid":"d9f66fa4-4d0e-4ed8-9786-68dfa63dc8a5","parentUuid":"8fe87903-df9b-4e85-8f80-471a46e20e59","uuid":"51159cf6-1fdd-4475-a4e0-bed8594d214c"},{"content":{"advice":{"changed":true,"value":"Manual checks are fragile. Acceptable for small projects with few dependencies."},"annotations":{"changed":false},"eventType":"EditAnswerEvent","followUpUuids":{"changed":false},"label":{"changed":true,"value":"Yes - manual check"},"metricMeasures":{"changed":true,"value":[{"measure":0.75,"metricUuid":"b681c5fb-2a05-4e19-be0e-6e5ccd13b58f","weight":0.5},{"measure":0.75,"metricUuid":"2a7fe444-029f-41e3-aae4-ae6b0645b4d4","weight":0.5}]}},"createdAt":"2026-05-10T22:26:25Z","entityUuid":"d9f66fa4-4d0e-4e